#!/usr/bin/env sh

# Ensure PATH includes common node locations
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# Detecta cambios respecto al upstream (si existe)
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)"
if [ -n "$UPSTREAM" ]; then
  BASE="$(git merge-base HEAD "$UPSTREAM")"
else
  BASE="$(git hash-object -t tree /dev/null)" # fallback: todo el repo
fi

# Evita correr en cambios de docs, etc.
CHANGED="$(git diff --name-only --diff-filter=ACMR "$BASE"...HEAD | grep -E '^(src|tests?|package\.json|vite|tsconfig|eslint|vitest)' || true)"
[ -z "$CHANGED" ] && echo "Sin cambios relevantes: saltando tests/build." && exit 0

export CI=true

echo "Ejecutando tests con cobertura…"
npm run test:coverage:quiet || { echo "Tests fallaron (verifica que el coverage supere los umbrales definidos en vitest.config.ts)"; exit 1; }

echo "Compilando app…"
npm run build:quiet || { echo "Build falló"; exit 1; }

# Bloquea solo en critical. Estaba en 'high', pero desde 2026-07 los avisos
# abiertos de next (y de postcss/sharp, que vienen con él) solo se arreglan en
# 16.3.0, que aún no tiene release estable: el gate quedaba imposible de pasar y
# obligaba a --no-verify, apagando de paso la verificación de build.
# Devolver a --audit-level=high cuando next 16.3.0 estable esté disponible.
echo "Verificando vulnerabilidades de seguridad…"
npm audit --omit=dev --audit-level=critical || { echo "⚠  Vulnerabilidades critical detectadas. Ejecuta 'npm audit' para ver detalles y 'npm audit fix' si corresponde."; exit 1; }

# Las high no bloquean, pero se reportan para no perderlas de vista.
npm audit --omit=dev --audit-level=high > /dev/null 2>&1 || echo "⚠  Hay vulnerabilidades high sin resolver (no bloquean el push). Revisa con 'npm audit --omit=dev'."

echo "Checks OK: procediendo con el push."
